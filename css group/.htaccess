# CSS Group website – Apache settings (cPanel)
Options -Indexes
DirectoryIndex index.html index.php
RewriteEngine On

# ===== Maintenance mode: switched on/off from the admin panel (admin.cssgroup.com.ng) =====
# When the file maintenance.flag exists, visitors get the maintenance page (HTTP 503) unless they use "Preview live site".
RewriteCond %{HTTP_HOST} ^(www\.)?cssgroup\.com\.ng$ [NC]
RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
RewriteCond %{HTTP_COOKIE} !css_preview=__PREVIEW_TOKEN__
RewriteCond %{REQUEST_URI} !^/(maintenance\.html|images/css-logo\.png)$
RewriteRule ^ - [R=503,L]
ErrorDocument 503 /maintenance.html

# ===== Force HTTPS =====
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ===== Old WordPress addresses -> new pages (main domain only; other sites on this account are untouched) =====
RewriteCond %{HTTP_HOST} !^(www\.)?cssgroup\.com\.ng$ [NC]
RewriteRule ^ - [S=17]
RewriteRule ^about-css-group/?$ /about.html [R=301,L]
RewriteRule ^our-services/?$ /services.html [R=301,L]
RewriteRule ^service/agriculture/?$ /agriculture.html [R=301,L]
RewriteRule ^service/construction/?$ /construction.html [R=301,L]
RewriteRule ^service/energy/?$ /energy.html [R=301,L]
RewriteRule ^service/aviation/?$ /aviation.html [R=301,L]
RewriteRule ^service/real-estate/?$ /real-estate.html [R=301,L]
RewriteRule ^service/ict/?$ /ict.html [R=301,L]
RewriteRule ^blog/?$ /news.html [R=301,L]
RewriteRule ^css-group-news/?$ /news.html [R=301,L]
RewriteRule ^category/css-group-news/?$ /news.html [R=301,L]
RewriteRule ^2025/01/03/bayelsa-state-government-invests-in-its-youths-for-food-sustainability/?$ /news-bayelsa.html [R=301,L]
RewriteRule ^2025/01/02/ebonyi-state-government-equips-youths-with-agricultural-entrepreneurial-skills-at-css-farms-nasarawa-state/?$ /news-ebonyi.html [R=301,L]
RewriteRule ^contact-us/?$ /contact.html [R=301,L]
RewriteRule ^company-overview/careers/?$ /careers.html [R=301,L]
RewriteRule ^job-listing-grid/?$ /careers.html [R=301,L]
RewriteRule ^shop-2/?$ /index.html [R=301,L]

# ===== Never serve stored form submissions =====
<FilesMatch "\.(jsonl|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
# config.js is rewritten by the admin panel: never cache it for long
<FilesMatch "^config\.js$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>
ErrorDocument 404 /index.html
